<Project>
  <PropertyGroup>
    <!-- Work around local SDK workload resolver issues that fail restore before compile. -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>

    <!-- Prefer the standard per-user NuGet cache so restore can work offline. -->
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == '' and Exists('$(UserProfile)\.nuget\packages')">$(UserProfile)\.nuget\packages</RestorePackagesPath>

    <!-- Do not fail restore when remote feeds are unreachable and packages already exist locally. -->
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>

    <!-- MSBuild graph restore can fail non-deterministically on some Windows setups when parallelized. -->
    <RestoreBuildInParallel>false</RestoreBuildInParallel>
  </PropertyGroup>
</Project>
